<div class="tile-text-info">
  <span class="subtext">
    {{tt this "text"}}
  </span>
  <OneIcon
    @icon="browser-info"
    class="template-info-icon"
    id={{tokenTemplateInfoTriggerId}}
  />
  <OneWebuiPopover
    @popoverStyle="token-template-type-info"
    @padding={{true}}
    @triggerSelector={{concat "#" tokenTemplateInfoTriggerId}}
    @placement={{if (media "isMobile") "bottom-right" "auto"}}
    as |popover|
  >
    <p class="api-command-tip-intro">
      {{tt this "tooltip"}}{{#if this.isLink1Present}}<a href={{tt this "link1"}} target="_blank">{{tt this "linkName1"}}</a>{{tt this "tooltip2"}}{{/if}}{{#if this.isLink2Present}}<a href={{tt this "link2"}} target="_blank">{{tt this "linkName2"}}</a>{{tt this "tooltip3"}}{{/if}}
    </p>
  </OneWebuiPopover>
</div>