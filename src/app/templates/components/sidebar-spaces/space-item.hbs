<OneIcon class="sidebar-item-icon" @icon="space" />
{{#if isRenaming}}
  <OneInlineEditor
    @isEditing={{true}}
    @value={{item.name}}
    @showEmptyInfo={{false}}
    @onSave={{action "rename"}}
    @editOnClick={{false}}
    @onEdit={{action "toggleRename"}}
    class="one-label name-editor sidebar-item-title"
    @click={{action "editorClick"}}
  />
{{else}}
  <div class="sidebar-item-title">
    <TruncatedString
      class={{concat-classes
        "sidebar-spaces-item-title"
        (if isIdMatchingFilter "sidebar-item-title-upper")
      }}
    >
      {{#if item.name}}
        <span class="item-name">
          {{emphasize-substring this.item.name this.sidebar.filter false "mark"}}
        </span>
      {{else}}
        <span class="one-label no-name">...</span>
      {{/if}}
    </TruncatedString>
    {{#if isIdMatchingFilter}}
      <TruncatedString class="sidebar-item-title-lower">
        <span class="space-id">
          {{tt this "id"}}
          <span>
            {{emphasize-substring this.item.entityId this.sidebar.filter false "mark"}}
          </span>
        </span>
      </TruncatedString>
    {{/if}}
  </div>
  {{#if isRecentlyUsedIconShown}}
    <OneIcon
      @icon="time-outline"
      class="recently-used-icon"
      style={{recentlyUsedIconStyle}}
    >
      <OneTooltip @title={{tt this "recentlyUsed"}} />
    </OneIcon>
  {{/if}}
  <StatusToolbar class="sidebar-spaces-status-toolbar" as |toolbar|>
    {{#if isInMarketplace}}
      <toolbar.icon @icon="cart-checked" @hint={{tt this "advertisedInMarketplace"}} />
    {{/if}}
    <toolbar.icon
      @outerText={{_totalSupportSizeHumanReadable}}
      @hint={{tt this "totalStorageHint" size=_totalSupportSizeHumanReadable}}
    />
    <toolbar.icon
      @icon="provider"
      @outerText={{_providersCount}}
      @hint={{tt this "supportCountHint" count=_providersCount}}
    />
  </StatusToolbar>
{{/if}}

{{#unless inSidenav}}
  <ActionsToolbar
    @isMinimized={{true}}
    @dropdownPlacement="auto"
    @actionsArray={{itemActions}}
  />
{{/unless}}
