<ContentInfo
  class="scroll-breakpoint-500"
  @header={{tt this "title"}}
  @text={{tt this "text"}}
>
  <p class="lead">
    <ul class="info">
      <li>
        <LinkTo @route="onedata.sidebar.content" @models={{array "clusters" "add"}}>
          {{tt this "liAddLink"}}
        </LinkTo>
        {{tt this "liAddDescription"}}
      </li>
    </ul>
  </p>
</ContentInfo>
