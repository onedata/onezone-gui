<RecordIcon class="sidebar-item-icon" @record={{item}} @useSubtypeIcon={{true}} />
{{#if isRenaming}}
  <OneInlineEditor
    @isEditing={{true}}
    @value={{item.name}}
    @showEmptyInfo={{false}}
    @onSave={{action "rename"}}
    @editOnClick={{false}}
    @onEdit={{action "toggleRename"}}
    class="one-label name-editor sidebar-item-title"
    @click={{action "editorClick"}}
  />
{{else}}
  <TruncatedString class="sidebar-item-title">
    <NameConflict @item={{item}} @tagName="span" class="one-label" />
  </TruncatedString>
{{/if}}

{{#unless inSidenav}}
  <ActionsToolbar
    @isMinimized={{true}}
    @dropdownPlacement="auto"
    @actionsArray={{itemActions}}
  />

  <RenderLater @triggerRender={{isRemoveModalOpened}} as |renderLater|>
    <HarvesterRemoveModal
      @opened={{isRemoveModalOpened}}
      @close={{action "closeRemoveModal"}}
      @proceed={{action "remove"}}
      @processing={{isRemoving}}
      @record={{harvester}}
      @onHidden={{renderLater.resetRenderTrigger}}
    />
  </RenderLater>
{{/unless}}
