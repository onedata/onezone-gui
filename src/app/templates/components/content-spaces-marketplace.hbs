{{#if isMarketplaceEnabled}}
  <ContentSpacesMarketplace::Header @viewModel={{viewModel}} />
  <PromiseProxyContainer @proxy={{viewModel.entriesInitialLoad}}>
    {{#if viewModel.showEmptyListView}}
      <ContentSpacesMarketplace::Empty @viewModel={{viewModel}} />
    {{else}}
      <ContentSpacesMarketplace::List @viewModel={{viewModel}} />
    {{/if}}
  </PromiseProxyContainer>
{{/if}}