<div class="row content-row header-row hidden-xs">
  <h1 class="normal-case with-menu">
    <TruncatedString class="token-name">{{token.name}}</TruncatedString>
    <ActionsToolbar
      @actionsArray={{globalActions}}
      @isMinimized={{true}}
      @renderImmediately={{true}}
    />
  </h1>
</div>
<div class="row content-row">
  <TokenEditor
    @mode={{mode}}
    @token={{token}}
    @onSubmit={{action "saveToken"}}
    @onCancel={{action (mut mode) "view"}}
  />
</div>
