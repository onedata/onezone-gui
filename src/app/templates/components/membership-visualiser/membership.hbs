<PromiseProxyContainer @proxy={{recordsProxy}} @sizeClass="xs">
  <PerfectScrollbarElement
    class="membership-scrollbar-element"
    @suppressScrollY={{true}}
    @onScroll={{action "scroll"}}
  >
    <MembershipVisualiser::MembershipPath
      @pathElements={{pathElements}}
      @modifyPrivileges={{modifyPrivileges}}
      @removeRelation={{removeRelation}}
      @view={{view}}
      @onPan={{action "pan"}}
      @isCondensed={{isCondensed}}
    />
  </PerfectScrollbarElement>
  <div class="bar-nav">
    {{#if scrollLeftButton}}
      <div class="scroll-button scroll-left" {{action "moveLeft"}}>
        <OneIcon @icon="arrow-left" />
      </div>
    {{/if}}
    {{#if scrollRightButton}}
      <div class="scroll-button scroll-right" {{action "moveRight"}}>
        <OneIcon @icon="arrow-right" />
      </div>
    {{/if}}
  </div>
  {{#if showDescription}}
    <div class="description">
      {{membershipDescription}}
    </div>
  {{/if}}
</PromiseProxyContainer>
