<OneTile
  @title={{tt this "title"}}
  @isLink={{isLink}}
  class={{tileClass}}
  @aspect={{aspect}}
  @moreText={{moreText}}
>
  {{#unless description}}
    <figure class="main-figure">
      <img class="main-image" src="assets/images/settings-circle-filled.svg">
      {{#if centeredMessage}}
        <div class="figure-text-centered">{{centeredMessage}}</div>
      {{/if}}
    </figure>
  {{/unless}}
  {{#if organizationName}}
    <div class="tile-element organization-name-row">
      <OneIcon @icon="organization" class="organization-name-icon" />
      <TruncatedString class="organization-name">
        <span >{{organizationName}}</span>
      </TruncatedString>
    </div>
  {{/if}}
  {{#if topMessage}}
    <div class="tile-element top-placeholder">
      {{topMessage}}
    </div>
  {{/if}}
  {{#unless noTags}}
    <TagsInput
      class="tile-element space-tags static-value"
      @tags={{inputTags}}
      @isReadOnly={{true}}
      @readonlyTagsDisplayLimit={{readonlyTagsDisplayLimit}}
      @onEvaluateMoreTagsText={{action "evaluateMoreTagsText"}}
    />
  {{/unless}}
  {{#if description}}
    <div class="tile-element description-row">
      <OneMarkdownToHtml class="markdown-view" @markdown={{description}} />
    </div>
  {{/if}}
</OneTile>