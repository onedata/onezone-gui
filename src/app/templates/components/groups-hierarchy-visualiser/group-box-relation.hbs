{{#if (not this.hasViewPrivilege)}}
  <OneIcon @icon="no-view" />
{{else if this.relationIsLoading}}
  {{!-- nbsp produces proper height of the box --}}
  &nbsp;
  <SpinSpinner @scale={{0.1}} @lines={{8}} @length={{20}} @width={{15}} />
{{else if this.relationIsRejected}}
  <OneIcon @icon="ban-left" />
{{else}}
  {{#if (eq this.relationType "children")}}
    <span class="relations-number">{{this.relationLength}}</span>
    <OneIcon @icon="arrow-right" />
  {{else}}
    <OneIcon @icon="arrow-left" />
    <span class="relations-number">{{this.relationLength}}</span>
  {{/if}}
{{/if}}

{{!-- optimization: rendering tooltip on hover --}}
<RenderLater @triggerRender={{this.renderTooltip}}>
  <OneTooltip @title={{this.tooltipText}} />
</RenderLater>
