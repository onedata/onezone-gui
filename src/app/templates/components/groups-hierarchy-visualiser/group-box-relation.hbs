{{#if (not hasViewPrivilege)}}
  <OneIcon @icon="no-view" />
{{else if relationIsLoading}}
  {{!-- nbsp produces proper height of the box --}}
  &nbsp;
  <SpinSpinner @scale={{0.1}} @lines={{8}} @length={{20}} @width={{15}} />
{{else if relationIsRejected}}
  <OneIcon @icon="ban-left" />
{{else}}
  {{#if (eq relationType "children")}}
    <span class="relations-number">{{relation.length}}</span>
    <OneIcon @icon="arrow-right" />
  {{else}}
    <OneIcon @icon="arrow-left" />
    <span class="relations-number">{{relation.length}}</span>
  {{/if}}
{{/if}}

{{!-- optimization: rendering tooltip on hover --}}
<RenderLater @triggerRender={{renderTooltip}}>
  <OneTooltip @title={{tooltipText}} />
</RenderLater>
