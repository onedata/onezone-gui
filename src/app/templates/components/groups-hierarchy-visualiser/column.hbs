<TruncatedString class="column-header">
  {{this.columnTitle}}
</TruncatedString>
<PerfectScrollbarElement
  class="group-boxes-container"
  @onScroll={{action "scroll"}}
  @supressScrollY={{this.column.groupsProxy.isPending}}
>
  <GroupsHierarchyVisualiser::ColumnDataContainer
    @columnDataModel={{this.column.columnDataModel}}
    as |dataContainer|
  >
    {{#each this.column.groupBoxes key="groupId" as |groupBox|}}
      <GroupsHierarchyVisualiser::GroupBox
        @groupBox={{groupBox}}
        @parentsRelationActive={{eq groupBox this.column.parentsRelationGroupBox}}
        @childrenRelationActive={{eq groupBox this.column.childrenRelationGroupBox}}
        @showParents={{action this.showParents this.column groupBox.group}}
        @showChildren={{action this.showChildren this.column groupBox.group}}
        @viewGroup={{action this.viewGroup groupBox.group}}
        @renameGroup={{action this.renameGroup groupBox.group}}
        @createRelativeGroup={{action this.createRelativeGroup groupBox.group}}
        @addYourGroup={{action this.addYourGroup groupBox.group}}
        @joinUsingToken={{action this.joinUsingToken groupBox.group}}
        @leaveGroup={{action this.leaveGroup groupBox.group}}
        @joinGroup={{action this.joinGroup groupBox.group}}
        @removeGroup={{action this.removeGroup groupBox.group}}
        @modifyPrivileges={{this.modifyPrivileges}}
        @removeRelation={{this.removeRelation}}
        @onRendered={{dataContainer.onGroupBoxRendered}}
      />
    {{/each}}
  </GroupsHierarchyVisualiser::ColumnDataContainer>
</PerfectScrollbarElement>
{{#if (or (not column.groupsProxy.isFulfilled) column.groupsProxy.isForbidden)}}
  <div class="column-loader">
    <PromiseProxyContainer
      @proxy={{this.column.groupsProxy}}
      @loadingLabel={{this.loadingLabel}}
    />
  </div>
{{/if}}
