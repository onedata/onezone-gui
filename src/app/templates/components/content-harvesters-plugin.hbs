{{#if isGuiAvailable}}
  <iframe src={{pluginPath}} class="plugin-frame {{if isGuiLoading "hidden"}}" onload={{action "pluginLoaded"}}></iframe>
{{else if (not checkingGuiAvailability)}}
  <ContentInfo
    class="scroll-breakpoint-500"
    @header={{tt this "errorHeader"}}
    @text={{tt this "errorBadConfiguration"}}
  >
  {{#unless isPublic}}
    <p class="lead text-center">
      {{tt this "errorPleaseVisit"}}
      <LinkTo
        @route="onedata.sidebar.content.aspect"
        @model="config"
        @query={{hash options="tab.gui-plugin-tab"}}
      >
        {{tt this "errorGuiPluginTab"}}
      </LinkTo>
      {{tt this "errorToSetup"}}
    </p>
    {{/unless}}
  </ContentInfo>
{{/if}}
{{#if (or checkingGuiAvailability isGuiLoading)}}
  <SpinSpinnerBlock @sizeClass="md" class="absolute-middle-centered" />
{{/if}}
