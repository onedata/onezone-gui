<PromiseProxyContainer @proxy={{this.isCustomFrontpageAvailableProxy}}>
  {{#if this.isCustomFrontpageShown}}
    <iframe
      id={{this.customFrontpageIframeId}}
      src={{this.frontpagePath}}
      frameborder="0"
      class="onezone-custom-frontpage-iframe"
      {{did-insert this.onIframeInserted}}
    ></iframe>
  {{else}}
    <LoginLayout @loginViewModel={{this.loginViewModel}}>
      <LoginBox @loginViewModel={{this.loginViewModel}} />
    </LoginLayout>
  {{/if}}
</PromiseProxyContainer>
