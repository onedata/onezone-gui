<TokenTemplateSelector::TemplateTile
  @templateName={{templateName}}
  @onClick={{if (eq activeSlideId "intro") (action "onIntroClick")}}
>
  <OneCarousel @activeSlideId={{activeSlideId}} as |carousel|>
    <carousel.slide @slideId="intro" class="info-token-slide">
      <figure class="main-figure">
        <img class="main-image" src={{imagePath}}>
      </figure>
      <div class="template-subtext">
    <span class="subtext">{{tt this "text"}}</span>&nbsp;<span class="info-icon">
      <OneIcon
        @icon="browser-info"
        class="template-info-icon"
        id={{tokenTemplateInfoTriggerId}}
      />
      <OneWebuiPopover
        @popoverStyle="token-template-type-info"
        @padding={{true}}
        @triggerSelector={{concat "#" tokenTemplateInfoTriggerId}}
        @placement={{if (media "isMobile") "bottom-right" "auto"}}
        as |popover|
      >
        <p class="api-command-tip-intro">
          {{tt this "tooltip"}}{{#if this.isLink1Present}}<a href={{tt this "link1"}} target="_blank">{{tt this "linkName1"}}</a>{{tt this "tooltip2"}}{{/if}}{{#if this.isLink2Present}}<a href={{tt this "link2"}} target="_blank">{{tt this "linkName2"}}</a>{{tt this "tooltip3"}}{{/if}}
        </p>
      </OneWebuiPopover>
    </span>
  </div>
    </carousel.slide>
    <carousel.slide @slideId="selector" class="record-selector-slide">
      <div class="top-bar">
        <a class="template-back" onClick={{action "onTemplateBackClick"}}>
          &laquo; {{t (concat i18nGenericPrefix "back")}}
        </a>
        {{#if recordsProxy.length}}
          <div class="form-group-light">
            <div class="input-group input-group-sm with-icon-addon">
              <SearchBar @search={{action (mut filter)}} class="form-control" />
              <div class="input-group-addon">
                <OneIcon @icon="search" />
              </div>
            </div>
          </div>
        {{/if}}
      </div>
      <RenderLater @triggerRender={{eq activeSlideId "selector"}}>
        <PerfectScrollbarElement class="records-container">
          <PromiseProxyContainer @proxy={{recordsProxy}}>
            {{#if filteredRecords.length}}
              <ul class="records-list">
                {{#each filteredRecords as |record|}}
                  <li class="record-item clickable" {{action "onRecordSelected" record}}>
                    <RecordIcon @record={{record}} @useSubtypeIcon={{true}} />
                    <TruncatedString><RecordName @record={{record}} /></TruncatedString>
                  </li>
                {{/each}}
              </ul>
            {{else if recordsProxy.length}}
              <p class="records-info no-records-after-filter-info">
                {{t (concat i18nGenericPrefix "noRecordsAfterInfo")}}
              </p>
            {{else}}
              <p class="records-info no-records-info">{{tt this "noRecordsInfo"}}</p>
            {{/if}}
          </PromiseProxyContainer>
        </PerfectScrollbarElement>
        <div class="scroll-top-shadow"></div>
        <div class="scroll-bottom-shadow"></div>
      </RenderLater>
    </carousel.slide>
  </OneCarousel>
</TokenTemplateSelector::TemplateTile>
