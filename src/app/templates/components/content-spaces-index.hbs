<div class="row content-row header-row hidden-xs">
  <h1 class="normal-case">
    <TruncatedString class="one-label">{{space.name}}</TruncatedString>
    <ActionsToolbar @actionsArray={{globalActions}} @isMinimized={{false}} />
  </h1>
</div>

<div class="row content-row">
  <div class="one-tile-container">
    {{#if (and
      dataProviderProxy.isFulfilled
      (or dataProviderProxy.content (gt providersProxy.content.length 0))
    )}}
      <OneTile
        class="text-center resource-browse-tile"
        @title={{tt this "tileDataTitle"}}
        @aspect={{if (not dataProviderProxy.content) "data" null}}
        @customLink={{if dataProviderProxy.content oneproviderHrefProxy.content null}}
        @moreText={{tt this "browseFiles"}}
      >
        <figure class="main-figure">
          <img class="main-image" src="assets/images/space-data.svg">
          <TruncatedString
            @tagName="span"
            class={{concat-classes "one-label" (if (not dataProviderProxy.content) "offline-warning")}}
          >
            {{#if dataProviderProxy.content}}
              {{dataProviderProxy.name}}
            {{else}}
              <OneIcon @icon="sign-warning-rounded" class="offline-warning-icon" />
              <span class="offline-text">{{tt this "providersOfflineText"}}</span>
            {{/if}}
          </TruncatedString>
        </figure>
      </OneTile>
    {{/if}}
    <ResourceInfoTile @record={{space}}>
      {{#if sharesCountInfo}}
        <tr>
          <td class="property-name">{{tt this "sharesCount"}}</td>
          <td class="property-value shares-count">
            {{!-- do not break line to avoid space --}}
            {{#if sharesCountInfo.areMoreAvailable}}
              {{tt this "over"}}
            {{/if}}
            {{or sharesCountInfo.count 0}}
          </td>
        </tr>
      {{/if}}
    </ResourceInfoTile>
    {{#if space.hasViewPrivilege}}
      {{#if isDetailsTileShown}}
        <SpaceDetailsTile @space={{space}} />
      {{/if}}
      <OneTile
        class="text-center resource-support-tile"
        @title={{tt this "tileProvidersTitle"}}
        @aspect={{if isSupported "providers" "support"}}
        @footerText={{if isSupported (tt this "addSupport")}}
        @footerTextIcon={{if isSupported "provider-add"}}
        @footerLinkToParams={{if (and isSupported hasAddSupportPrivilege) (array "onedata.sidebar.content.aspect" "spaces" spaceId "support")}}
        @tooltipText={{noAddSupportPrivilegeTooltipText}}
        @footerClass={{if (not hasAddSupportPrivilege) "not-allowed"}}
      >
        <LoadingContainer
          @isLoading={{not (or space.providerList.isLoaded space.providerList.list.isFulfilled)}}
        >
          {{#if isSupported}}
            <div class="support-chart-container absolute-align-middle-center full-width">
              <SpaceProvidersSupportChart
                @space={{space}}
                @providersColors={{providersColors}}
                @forceMobile={{true}}
                @hideLegend={{true}}
              />
            </div>
          {{else}}
            <figure class="main-figure">
              <img class="main-image" src="assets/images/space-get-support.svg">
              <span class="one-label">{{tt this "addSupport"}}</span>
            </figure>
          {{/if}}
        </LoadingContainer>
      </OneTile>
      <ProvidersMapTile
        class="resource-map-tile"
        @providersProxy={{providersProxy}}
        @aspect={{if isSupported "providers" "support"}}
        @title={{tt this "tileProvidersMapTitle"}}
      />
      {{#if isMarketplaceTileShown}}
        <SpaceMarketplaceTile
          @space={{space}}
          @onDismiss={{action "dismissMarketplaceTile"}}
        />
      {{/if}}
      <ResourceMembersTile @record={{space}} />
    {{/if}}
    {{#if showResourceMembershipTile}}
      <ResourceMembershipTile @record={{space}} />
    {{/if}}
    {{yield}}
  </div>
</div>
