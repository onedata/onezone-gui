{{#if subjectDescription}}
  <p class="subject-description">
    {{subjectDescription}}
  </p>
{{/if}}
<PromiseProxyContainer @proxy={{dataLoadingProxy}} @sizeClass="sm">
  <p class="limitations-description">
    <span class="limitations-text"><strong>{{limitationsDescription}}</strong></span>
    {{#if showCustomTokenLink}}
      <a
        href={{customTokenUrlProxy.content}}
        class="custom-token-action"
        {{action onCustomTokenClick preventDefault=false}}
      >
        {{tt this "customTokenLabel"}}
      </a>
      {{tt this "postCustomTokenLabel"}}
    {{/if}}
  </p>
  <OneClipboardLine
    @value={{generatedTokenProxy.content}}
    @type="textarea"
    @inputClass="token-textarea"
    @textareaRows={{7}}
  />
  {{#if variablesDescription}}
    <p class="variables-description">
      {{variablesDescription.content}}
      {{#if variablesDescription.tip}}
        <OneLabelTip @title={{variablesDescription.tip}} />
      {{/if}}
    </p>
  {{/if}}
</PromiseProxyContainer>
{{yield}}
