{{#unless (eq harvesterSpacesProxy.length 0)}}
  <div class="row content-row header-row hidden-xs">
    <h1 class="with-menu">
      <span class="one-label">
        {{tt this "header"}}
      </span>
      <ActionsToolbar @isMinimized={{true}} @actionsArray={{globalActions}} />
    </h1>
    <div
      class="form-group form-group-sm form-group-light search-group content-search with-place-for-dots"
    >
      <div class="input-group with-icon-addon">
        <SearchBar @search={{action (mut searchString)}} class="form-control" />
        <div class="input-group-addon">
          <OneIcon @icon="search" />
        </div>
      </div>
    </div>
  </div>
{{/unless}}
<PromiseProxyContainer @proxy={{harvesterSpacesProxy}}>
  {{#if (eq harvesterSpacesProxy.length 0)}}
    <ContentInfo
      @imagePath={{root-url "assets/images/harvester-space-new.svg"}}
      class="scroll-breakpoint-800"
      @header={{tt this "harvesterSpaces"}}
      @text={{tt this "noSpaces"}}
    >
      <div class="action-buttons">
        <OneButton
          class="btn btn-primary btn-content-info btn-add-your-space"
          @onClick={{action "openAddYourSpaceModal"}}
        >
          {{tt this "addYourSpace"}}
        </OneButton>
        &#32;
        <OneButton
          class="btn btn-primary btn-content-info btn-invite-space"
          @onClick={{action "inviteSpaceUsingToken"}}
        >
          {{inviteSpaceUsingTokenAction.title}}
        </OneButton>
      </div>
    </ContentInfo>
  {{else}}
    <ResourcesList @items={{filteredSpaceItems}} @isResourceWithAdditionalInfo={{true}} />
  {{/if}}
</PromiseProxyContainer>
