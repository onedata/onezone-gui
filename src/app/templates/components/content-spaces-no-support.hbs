<ContentInfo @class="scroll-breakpoint-600" @header={{tt this "header"}} @text={{tt this "text"}}>
  <p class="lead">
    <ul class="info">
      <li>
        {{tt this "addSupportIfAdministrator"}}
        <LinkTo
          @route="onedata.sidebar.content.aspect"
          @model="support"
          class="btn-add-support"
        >
          <div class="inline-icon-container provider-add-icon-container">
            <OneIcon @icon="provider-add" @class="provider-add-icon" />
          </div>
          {{tt this "addSupportLink"}}
        </LinkTo>
        {{tt this "addSupportChoose"}}
      </li>
      <li>
        {{tt this "contactUser"}}
      </li>
    </ul>  
  </p>
</ContentInfo>
