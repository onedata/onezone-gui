<PromiseProxyContainer @proxy={{backendTypesListProxy}}>
  <div class="form form-horizontal form-component">
    <FormComponent::FieldRenderer @field={{fields}} />
    <div class="text-center">
    {{#if (eq mode "view")}}
      <div class="form-group edit-btn-form-group">
        <div class="control-label"></div>
        <OneButton @type="default" @onClick={{action "edit"}} class="edit-btn">
          {{tt this "edit"}}
        </OneButton>
      </div>
    {{else}}
      <OneButton
        @type="primary"
        @buttonType="submit"
        class="submit-btn"
        @disabled={{not fields.isValid}}
        @onClick={{action "submit"}}
      >
        {{tt this (if (eq mode "create") "create" "save")}}
      </OneButton>

      {{#if (eq mode "edit")}}
        <OneButton
          @type="default"
          @onClick={{action "cancel"}}
          @disabled={{disabled}}
          class="cancel-btn"
        >
          {{tt this "cancel"}}
        </OneButton>
      {{/if}}
    {{/if}}
    </div>
  </div>
</PromiseProxyContainer>
