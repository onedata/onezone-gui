<h1>
  <span class="one-label">{{tt this "header"}}</span>
  <OneLabelTip @title={{tt this "sectionHint"}} />
  {{#if dataLoadingProxy.isFulfilled}}
    <div class="pull-right header-buttons">
      {{#if (eq mode "view")}}
        <OneButton
          @type="default"
          @size="sm"
          @onClick={{action "edit"}}
        >{{tt this "edit"}}</OneButton>
      {{else}}
        <OneButton
          @type="default"
          @size="sm"
          @onClick={{action "useDefaults"}}
          @disabled={{not isUseDefaultsEnabled}}
        >
          {{#if (and (not isSaving) (not defaultConfiguration))}}
            <OneTooltip @title={{tt this "noDefaults"}} />
          {{/if}}
          {{tt this "useDefaults"}}
        </OneButton>
        <OneButton
          @type="default"
          @size="sm"
          @onClick={{action "cancel"}}
          @disabled={{isSaving}}
        >{{tt this "cancel"}}</OneButton>
        <OneButton
          @type="primary"
          @buttonType="submit"
          @size="sm"
          @disabled={{not isValid}}
          @onClick={{action "save"}}
        >
          {{tt this "save"}}
        </OneButton>
      {{/if}}
    </div>
  {{/if}}
</h1>
<PromiseProxyContainer @proxy={{dataLoadingProxy}}>
  <JsonEditor
    @value={{editorValue}}
    @disabled={{isSaving}}
    @isReadOnly={{eq mode "view"}}
    @acceptEmptyString={{true}}
    @onChange={{action "configurationChange"}}
  />
</PromiseProxyContainer>
