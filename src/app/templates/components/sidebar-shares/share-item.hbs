<OneIcon @class="sidebar-item-icon" @icon={{icon}} />
<div class="sidebar-item-title">
  <TruncatedString @class="sidebar-item-title-upper">
    {{#if item.name}}
      <NameConflict @item={{item}} @tagName="span" @class="one-label share-name" />
    {{else}}
      <span class="one-label share-name no-name">...</span>
    {{/if}}
  </TruncatedString>
  <TruncatedString @class="sidebar-item-title-lower">
    <strong>{{tt this "space"}}:</strong>
    {{#if spaceProxy.name}}
      <span class="space-name">{{spaceProxy.name}}</span>
    {{else}}
      <em>{{tt this "unknown"}}</em>
    {{/if}}
  </TruncatedString>
</div>
  {{#if isPublicData}}
    <StatusToolbar as |toolbar|>
      <toolbar.icon
        @icon="globe-cursor"
        @hint={{publicDataTip}}
      />
    </StatusToolbar>
  {{/if}}
{{#unless inSidenav}}
  <ActionsToolbar
    @isMinimized={{true}}
    @dropdownPlacement="auto"
    @actionsArray={{itemActions}}
  />
{{/unless}}
