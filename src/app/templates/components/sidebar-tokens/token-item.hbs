<OneIcon @icon={{iconName}} class="sidebar-item-icon" />
{{#if isRenaming}}
  <OneInlineEditor
    @isEditing={{true}}
    @value={{item.name}}
    @showEmptyInfo={{false}}
    @onSave={{action "rename"}}
    @editOnClick={{false}}
    @onEdit={{action "toggleRename"}}
    class="one-label name-editor token-name sidebar-item-title"
    @click={{action "editorClick"}}
  />
{{else}}
  <div class="sidebar-item-title">
    <TruncatedString class={{if (not token.isActive) "sidebar-item-title-upper"}}>
      <NameConflict @item={{item}} @tagName="span" class="one-label token-name" />
    </TruncatedString>
    {{#if (not token.isActive)}}
      <TruncatedString class="sidebar-item-title-lower">
        {{tt this (if token.isObsolete "expired" "revoked")}}
      </TruncatedString>
    {{/if}}
  </div>
{{/if}}

<ActionsToolbar @isMinimized={{true}} @dropdownPlacement="auto" @actionsArray={{actionsArray}} @toolbarToggleClasses="token-menu-trigger" @toolbarClasses="btn-toolbar" @popoverClass="token-toolbar-popover" />
<RenderLater @triggerRender={{isRemoveTokenModalOpened}} as |renderLater|>
  <RemoveTokenModal
    @opened={{isRemoveTokenModalOpened}}
    @proceed={{action "remove"}}
    @close={{action "closeRemoveTokenModal"}}
    @processing={{isRemovingToken}}
    @token={{token}}
    @onHidden={{renderLater.resetRenderTrigger}}
  />
</RenderLater>
{{yield}}
