<div class="type-filter-row filter-row">
  <label class="filter-label">{{tt this "typeFilter.label"}}:</label>
  <BsButtonGroup
    @value={{this.selectedType}}
    class="type-filter filter-control"
    @type="radio"
    @onChange={{action "typeChanged"}}
    as |bg|
  >
    <bg.button @type="default" class="btn-sm btn-all" @value="all">
      {{tt this "typeFilter.values.all"}}
    </bg.button>
    <bg.button @type="default" class="btn-sm btn-access" @value="access">
      {{tt this "typeFilter.values.access"}}
    </bg.button>
    <bg.button @type="default" class="btn-sm btn-identity" @value="identity">
      {{tt this "typeFilter.values.identity"}}
    </bg.button>
    <bg.button @type="default" class="btn-sm btn-invite" @value="invite">
      {{tt this "typeFilter.values.invite"}}
    </bg.button>
  </BsButtonGroup>
</div>
<OneCollapse
  @collapsed={{not this.isTargetFilterVisible}}
  class="target-filter-row-collapse"
>
  <div class="target-filter-row filter-row">
    <label class="filter-label">{{tt this "targetFilter.label"}}:</label>
    <div class="filter-control target-filter">
      <OneDropdown
        class="target-model-filter"
        @tagName="div"
        @triggerClass="small"
        @dropdownClass="small"
        @options={{this.targetModelOptions}}
        @onChange={{action "targetModelChanged"}}
        @selected={{this.selectedTargetModelOption}}
        @renderInPlace={{true}}
        as |option|
      >
        <TruncatedString class="option-container">
          {{#if option.icon}}
            <OneIcon class="model-icon" @icon={{option.icon}} />
          {{/if}}
          <span
            class="text model-name"
          >{{tt this (concat "targetFilter.model.options." option.modelName)}}</span>
        </TruncatedString>
      </OneDropdown>
      {{#if this.targetRecordOptionsLoaderProxy.isPending}}
        <div class="dropdown-loader">
          <SpinSpinnerBlock @sizeClass="xs" />
          <div class="dropdown-loader-text truncate">
            {{#if (eq this.selectedTargetModelOption this.allModelOption)}}
              {{tt this "loadingFilters"}}
            {{else}}
              {{tt this "loadingFilters"
                progress=this.tokensFullLoadData.progressTracker.progressText
              }}
            {{/if}}
          </div>
        </div>
      {{else}}
        <OneDropdown
          class="target-record-filter"
          @tagName="div"
          @triggerClass="small"
          @dropdownClass="small"
          @options={{this.targetRecordOptions}}
          @onChange={{action "targetRecordChanged"}}
          @selected={{this.effSelectedTargetRecordOption}}
          @renderInPlace={{true}}
          @disabled={{this.isTargetRecordDisabled}}
          @searchEnabled={{true}}
          @searchField="name"
          as |option|
        >
          <TruncatedString>
            {{#if option.record}}
              <NameConflict @item={{option.record}} />
            {{else}}
              {{option.name}}
            {{/if}}
          </TruncatedString>
        </OneDropdown>
      {{/if}}
    </div>
  </div>
</OneCollapse>
