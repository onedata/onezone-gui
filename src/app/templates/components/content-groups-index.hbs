<div class="row content-row header-row hidden-xs has-border">
  <h1 class="with-menu normal-case">
    <span class="one-label">
      {{group.name}}
    </span>
  </h1>
</div>
<div class="row content-row">
  <PromiseProxyContainer @proxy={{user}}>
    <div class="one-tile-container">
      <ResourceInfoTile @record={{group}} />
      {{#if group.hasViewPrivilege}}
        <ResourceMembersTile @record={{group}} />
      {{/if}}
      <ResourceMembershipTile @record={{group}} />
    </div>
  </PromiseProxyContainer>
</div>
