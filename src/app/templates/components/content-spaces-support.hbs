{{#if hasAddSupportPrivilege}}
  <div class="row content-row header-row hidden-xs">
    <h1>
      <span class="one-label">
        {{tt this "header"}}
      </span>
    </h1>
  </div>

  <div class="row content-row">
    <OneBsTab class="only-tab-bar bs-tab-onedata bs-tab-modern" as |tab|>
      <tab.pane @title={{tt this "requestSupport.tabName"}}>
        <ContentSpacesSupport::RequestSupport @space={{space}} />
      </tab.pane>
      <tab.pane @title={{tt this "deployProvider.tabName"}}>
        <ContentSpacesSupport::DeployProvider @space={{space}} />
      </tab.pane>
      <tab.pane @title={{tt this "exposeData.tabName"}}>
        <ContentSpacesSupport::ExposeData @space={{space}} />
      </tab.pane>
    </OneBsTab>
  </div>
{{else}}
  <ContentInfo
    class="scroll-breakpoint-600"
    @header={{tt this "requireAddSupportHeader"}}
    @imagePath={{root-url "assets/images/no-view.svg"}}
  >
    <p class="lead insufficient-privileges">
      {{tt this "requireAddSupportText"}}
    </p>
    <p class="lead insufficient-privileges">
      {{tt this "navigateTo"}}
      <LinkTo
        @route="onedata.sidebar.content.aspect"
        @models={{array "spaces" (model-routable-id space) "members"}}
      >
        {{tt this "privilegeManagement"}}
      </LinkTo>
    </p>
  </ContentInfo>
{{/if}}
