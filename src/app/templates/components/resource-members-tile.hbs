<OneTile @title={{tt this "title"}} @class="resource-members-tile" @aspect="members">
  <PromiseProxyContainer @proxy={{membersProxy}}>
    <p>{{tt this "effective"}}</p>
    <div class="members-counter-row">
      <div class="members-counter">
        <OneIcon @icon="groups"><OneTooltip @title={{tt this "groups"}} /></OneIcon>
        <span class="effective-groups-counter">
          {{format-number membersProxy.effGroupList.length}}
        </span>
      </div>
      <div class="members-counter">
        <OneIcon @icon="user"><OneTooltip @title={{tt this "users"}} /></OneIcon>
        <span class="effective-users-counter">
          {{format-number membersProxy.effUserList.length}}
        </span>
      </div>
    </div>
    <p>{{tt this "direct"}}</p>
    <div class="members-counter-row">
      <div class="members-counter">
        <OneIcon @icon="groups"><OneTooltip @title={{tt this "groups"}} /></OneIcon>
        <span class="direct-groups-counter">
          {{format-number membersProxy.groupList.length}}
        </span>
      </div>
      <div class="members-counter">
        <OneIcon @icon="user"><OneTooltip @title={{tt this "users"}} /></OneIcon>
        <span class="direct-users-counter">
          {{format-number membersProxy.userList.length}}
        </span>
      </div>
    </div>
  </PromiseProxyContainer>
</OneTile>
