<tr>
  <td class="privileges-column">
    <div class="header-container">
      <div class="header-text">{{tt this "privileges"}}</div>
      <OneLabelTip @title={{tt this "privilegesTip" entityType=modelTypeTranslation}} />
    </div>
  </td>
  <td class="toggle-column">
    <div class="header-container">
      <div class="header-text">{{tt this "direct"}}</div>
      <OneLabelTip @title={{tt this "directTip" entityType=modelTypeTranslation}} />
    </div>
  </td>
  {{#if (not isBulkEdit)}}
    <td class="toggle-column">
      <div class="header-container">
        <div class="header-text">{{tt this "effective"}}</div>
        <OneLabelTip @title={{tt this "effectiveTip" entityType=modelTypeTranslation}} />
      </div>
    </td>
  {{/if}}
</tr>