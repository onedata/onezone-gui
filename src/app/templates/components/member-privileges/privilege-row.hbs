<td class={{concat-classes
    "priv"
    (if isModifiedPriv "modified-priv")
  }}
>
  {{privilege.text}}
</td>
<td class={{concat-classes "toggle-column direct" (if (not isDirect) "na")}}>
  {{#if isDirect}}
    <form.group>
      <OneWayToggle
        class={{inputClass}}
        @inputId={{inputId}}
        @checked={{directPrivilegeValue}}
        @threeState={{privilege.field.threeState}}
        @allowThreeStateToggle={{privilege.field.allowThreeStateToggle}}
        @showLockForReadOnly={{false}}
        @isReadOnly={{or isPrivilegesToggleDisabled (not editionEnabled)}}
        @update={{action "inputChanged"}}
        @lockHint={{if isPrivilegesToggleDisabled insufficientPrivilegesTip}}
      />
    </form.group>
  {{else}}
    {{tt this "na"}}
  {{/if}}
</td>
{{#if (not isBulkEdit)}}
  <td
    class={{concat-classes
      "toggle-column effective"
      (if (not effPrivilegeState) "revoke")
    }}
    onmouseover={{action "highlightMemberships"}}
    onmouseleave={{action "resetHighlights"}}
  >
    <div class="effective-cell-container">
      <PromiseProxyContainer @proxy={{effPrivilegesRealAffectorRecords}} @sizeClass="xxs">
        {{#if (eq effPrivilegeState 2)}}
          <div class="priv-unknown">?</div>
          <OneTooltip @title={{tt this "unknownPrivilege"}} />
        {{else if effPrivilegeState}}
          <OneIcon @icon="checked" />
          <OneTooltip @title={{tooltipText}} />
        {{else}}
          <div class="priv-revoke">–</div>
        {{/if}}
      </PromiseProxyContainer>
      {{#if (not arePrivilegesUpToDate)}}
        <SpinSpinnerBlock
          @sizeClass="xxs"
          class="members-updating-privileges-spinner"
        />
      {{/if}}
    </div>
  </td>
{{/if}}
