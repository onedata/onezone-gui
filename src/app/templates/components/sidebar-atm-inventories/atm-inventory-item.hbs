<RecordIcon @record={{atmInventory}} class="sidebar-item-icon" />
{{#if isRenaming}}
  <OneInlineEditor
    @isEditing={{true}}
    @value={{atmInventory.name}}
    @showEmptyInfo={{false}}
    @onSave={{action "rename"}}
    @editOnClick={{false}}
    @onEdit={{action "toggleRename"}}
    class="one-label name-editor atm-inventory-name sidebar-item-title"
    @click={{action "editorClick"}}
  />
{{else}}
  <TruncatedString class="sidebar-item-title">
    <NameConflict
      @item={{atmInventory}}
      @tagName="span"
      class="one-label atm-inventory-name"
    />
  </TruncatedString>
{{/if}}
{{#unless inSidenav}}
  <ActionsToolbar
    @isMinimized={{true}}
    @dropdownPlacement="auto"
    @actionsArray={{itemActions}}
    @toolbarToggleClasses="atm-inventory-menu-trigger"
  />
{{/unless}}
{{yield}}
