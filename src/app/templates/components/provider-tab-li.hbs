{{#if (eq item.type "provider")}}
  <span
    class={{concat-classes "provider-info-container nav-link" (if isActive "active")}}
    onclick={{action "anchorClicked"}}
  >
    <RecordInfoWithIcon
      @record={{provider}}
      @recordType="provider"
      class="provider-info-name"
    />
    {{#unless isInRequiredVersion}}
      <OneIcon class="provider-warning-icon" @icon="sign-warning-rounded">
        <OneTooltip @title={{tt this "versionTooLowWarning"}} />
      </OneIcon>
    {{/unless}}
  </span>
{{else if (eq item.type "overview")}}
  <div
    class={{concat-classes "nav-link truncate" (if isActive "active")}}
    onclick={{action "anchorClicked"}}
    ignoreTouchAction=true
  >
    <div class="inline-icon-container not-animation">
      <OneIcon @icon={{item.icon}} />
    </div>
    <span class="tab-name one-label">{{tt this "overviewName"}}</span>
  </div>
{{/if}}
