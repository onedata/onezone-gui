<ErrorCheckView
  @tryErrorCheckProxy={{tryErrorCheckProxy}}
  @errorCheckProxy={{errorCheckProxy}}
>
  <ContentInfo
    class="scroll-breakpoint-700"
    @header={{tt this "header"}}
    @imagePath={{root-url "assets/images/no-connection.svg"}}
  >
    <p class="lead">
      <ul class="info">
        <li>
          {{tt this "liTryAgain1"}}
          <LinkTo
            @route="onedata.sidebar.content.aspect"
            @models={{array "clusters" (model-routable-id cluster) "overview"}}
          >
            {{tt this "liTryAgainLink"}}
          </LinkTo>
          {{tt this "liTryAgain2"}}.
        </li>
        <li>
          {{tt this "liMakeSure1"}}
          <a 
            href={{emergencyOnepanelUrl}} 
            target="_blank" 
            onmousedown={{action "setFastPolling"}}
          >{{tt this "liMakeSureLink"}}</a>.
        </li>
        {{#if (eq cluster.type "oneprovider")}}
          <li>
            {{tt this "liDeregister1"}}
            <LinkTo
              @route="onedata.sidebar.content.aspect"
              @models={{array "clusters" clusterEntityId "deregister"}}
              class="text-danger"
            >{{tt this "liDeregisterLink"}}</LinkTo>.
          </li>
        {{/if}}
      </ul>
    </p>
  </ContentInfo>
</ErrorCheckView>
