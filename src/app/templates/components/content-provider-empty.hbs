<ContentInfo
  class="scroll-breakpoint-600"
  @header={{tt this "addSupportHeader"}}
  @text={{tt this "leadText"}}
>
  <p class="lead">
    <ul class="info">
      <li>
        {{tt this "p1_1"}}
        <LinkTo @route="onedata.sidebar" @model="spaces">
          {{tt this "manageSpacesHead"}}
        </LinkTo>
        {{tt this "p1_2"}}
        <LinkTo @route="onedata.sidebar.content" @models={{array "spaces" "new"}}>
          {{tt this "create"}}
        </LinkTo>
        {{tt this "p1_3"}}
      </li>
      <li>
        {{tt this "pIfYouHave"}}
        <strong>{{tt this "space"}} {{tt this "invitationToken"}}</strong>,
        <LinkTo @route="onedata.sidebar.content" @models={{array "tokens" "join"}}>
          {{tt this "joinSpace"}}
        </LinkTo>
      </li>
      <li>
        {{tt this "pIfYouHave"}}
        <strong>{{tt this "group"}} {{tt this "invitationToken"}}</strong>,
        <LinkTo @route="onedata.sidebar.content" @models={{array "tokens" "join"}}>
          {{tt this "joinGroup"}}
        </LinkTo>
        {{tt this "p3_1"}}
      </li>
    </ul>  
  </p>
</ContentInfo>
