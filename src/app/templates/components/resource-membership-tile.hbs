<OneTile
  @title={{tt this "title"}}
  @aspect="members"
  @routeQueryParams={{queryParams}}
  class="resource-membership-tile"
>
  <PromiseProxyContainer @proxy={{userProxy}}>
    <MembershipVisualiser
      @contextRecord={{userProxy.content}}
      @targetRecord={{record}}
      @maxPathsNumber={{4}}
      @visibleBlocks={{2}}
      @isCondensed={{true}}
    />
  </PromiseProxyContainer>
</OneTile>
