<ContentInfo
  class="scroll-breakpoint-500"
  @header={{tt this "title"}}
  @text={{tt this "text"}}
>
  <p class="lead">
    <ul class="info">
      <li>
        <LinkTo @route="onedata.sidebar.content" @models={{array "harvesters" "new"}}>
          {{tt this "aCreateHarvester"}}
        </LinkTo>
        {{tt this "pCreateHarvester"}}
      </li>
      <li>
        {{tt this "pJoinHarvester"}}
        <LinkTo @route="onedata.sidebar.content" @models={{array "tokens" "join"}}>
          {{tt this "aJoinHarvester"}}
        </LinkTo>
      </li>
      <li>
        {{tt this "p1JoinGroup"}}
        <LinkTo @route="onedata.sidebar.content" @models={{array "tokens" "join"}}>
          {{tt this "aJoinGroup"}}
        </LinkTo>
        {{tt this "p2JoinGroup"}}
      </li>
    </ul>  
  </p>
</ContentInfo>
