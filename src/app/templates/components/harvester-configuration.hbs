<OneBsTab
  @activeId={{activeTab}}
  @onChange={{action "onTabChange"}}
  class="bs-tab-onedata bs-tab-modern"
  as |tab|
>
  <tab.pane @id="general-tab" @title={{tt this "generalHeader"}}>
    <HarvesterConfiguration::General @harvester={{harvester}} />
  </tab.pane>
  <tab.pane @id="gui-plugin-tab" @title={{tt this "guiPluginHeader"}}>
    <HarvesterConfiguration::GuiPlugin @harvester={{harvester}} />
  </tab.pane>
</OneBsTab>
