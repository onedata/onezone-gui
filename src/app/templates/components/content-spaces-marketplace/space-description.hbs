<OneMarkdownToHtml class="markdown-view" @markdown={{spaceItem.description}} />
{{#if hasOverflow}}
  <div class="toggle-expand-btn expand-btn">
    <a class="toggle-expand-anchor navy" onclick={{action "expand"}}>
      <OneIcon @icon="info-modal" class="expand-icon" />
      <span class="text">{{tt this "expand"}}</span>
    </a>
  </div>
{{/if}}