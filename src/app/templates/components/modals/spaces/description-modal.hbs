<GlobalModal
  @classNames="spaces-description-modal"
  @modalId={{modalId}}
  @size="lg"
  as |modal|
>
  <modal.header>
    <h1>
      <span class="one-label">{{tt this "header"}}</span>
    </h1>
    <h2 class="normal-case">
      <TruncatedString class="space-name">
        <div class="inline-icon-container">
          <RecordIcon @modalName="space" />
        </div>
        <NameConflict @item={{spaceData}} />
      </TruncatedString>
    </h2>
  </modal.header>

  <modal.body>
    <OneMarkdownToHtml
      class="description-markdown-view markdown-view"
      @markdown={{spaceData.description}}
    />
  </modal.body>

  <modal.footer class="btn-toolbar">
    <OneButton @type="default" class="close-btn" @onClick={{modal.close}}>
      {{tt this "close"}}
    </OneButton>
  </modal.footer>

</GlobalModal>
