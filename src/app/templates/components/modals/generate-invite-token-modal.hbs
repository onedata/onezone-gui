<GlobalModal @classNames="generate-invite-token-modal" @modalId={{modalId}} as |modal|>

  <modal.header>
    <h1>{{tt this (concat "header." inviteType)}}</h1>
  </modal.header>

  <modal.body>
    <InviteTokenGenerator
      @inviteType={{inviteType}}
      @targetRecord={{targetRecord}}
      @onCustomTokenClick={{modal.close}}
    />
  </modal.body>

  <modal.footer class="btn-toolbar">
    <OneButton @type="default" class="modal-close" @onClick={{modal.close}}>
      {{tt this "close"}}
    </OneButton>
  </modal.footer>

</GlobalModal>
