<GlobalModal
  @classNames="api-samples-modal"
  @modalId={{modalId}}
  @size="lg"
  as |modal|
>
  <modal.header>
    <h1>
      <span class="one-label">{{tt this "header"}}</span>
    </h1>
    <h2 class="normal-case">
      <TruncatedString class="record-name">
        <div class="inline-icon-container">
          <OneIcon @icon={{icon}} />
        </div>
        {{record.name}}
      </TruncatedString>
    </h2>
  </modal.header>
  <modal.body>
    <PromiseProxyContainer
      @proxy={{apiSamplesProxy}}
      @sizeClass="sm"
      @centered={{false}}
      @spinnerBlockClass="loading-api-command absolute-middle-centered"
    >
      <ApiSamples @apiSamples={{apiSamples}} @apiSubject={{apiSubject}} />
    </PromiseProxyContainer>
  </modal.body>
  <modal.footer class="btn-toolbar">
    <OneButton @type="default" class="modal-close" @onClick={{modal.close}}>
      {{tt this "close"}}
    </OneButton>
  </modal.footer>
</GlobalModal>