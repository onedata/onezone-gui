<h2>{{tt this "header"}}</h2>
<div class="detail">
  <span class="detail-label filename-label">{{tt this "filename"}}:</span>
  <TruncatedString class="detail-value filename">{{filename}}</TruncatedString>
</div>
<OneButton
  class="upload-btn"
  @type="default"
  @size="sm"
  @disabled={{isDisabled}}
  @onClick={{action "reupload"}}
>
  {{tt this "uploadButton"}}
</OneButton>
{{yield}}
