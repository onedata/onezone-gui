<ContentInfo
  class="scroll-breakpoint-500"
  @header={{tt this "title"}}
  @text={{tt this "text"}}
>
  <p class="lead">
    <ul class="info">
      <li>
        <LinkTo @route="onedata.sidebar.content" @models={{array "spaces" "new"}}>
          {{tt this "p1a"}}
        </LinkTo>
        {{tt this "p1t"}}
      </li>
      <li>
        {{tt this "p2t"}}
        {{!-- no line break because of dot on the end --}}
        <LinkTo
          @route="onedata.sidebar.content"
          @models={{array "tokens" "join"}}
        >{{tt this "p2a"}}</LinkTo>.
      </li>
      <li>
        {{tt this "p3t1"}}
        <LinkTo @route="onedata.sidebar.content" @models={{array "tokens" "join"}}>
          {{tt this "p3a"}}
        </LinkTo>
        {{tt this "p3t2"}}
      </li>
      {{#if isMarketplaceInfoShown}}
        <li>
          {{tt this "pMarketPrefix"}}
          <LinkTo @route="onedata.sidebar.content" @models={{array "spaces" "join"}}>
            {{tt this "pMarketAnchor"}}
          </LinkTo>
          {{tt this "pMarketSuffix"}}
        </li>
      {{/if}}
    </ul>
  </p>
</ContentInfo>
