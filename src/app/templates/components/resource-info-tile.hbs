<OneTile @title={{tt this "title"}} @isLink={{false}} @class="resource-info-tile">
  <PromiseProxyContainer @proxy={{creatorProxy}}>
    <table class="table table-condensed">
      <tbody>
        <tr>
          <td class="property-name">{{tt this "name"}}</td>
          <td class="property-value">
            <OneInlineEditor
              @value={{record.name}}
              @onSave={{action "saveName"}}
              class="resource-name"
            />
          </td>
        </tr>
        <tr>
          <td class="property-name">{{tt this "creator"}}</td>
          {{#if (eq creatorIcon "user")}}
            <td class="property-value user-info">
              <RecordInfoWithIcon @record={{creatorProxy.content}} />
            </td>
          {{else}}
            <TruncatedString
              @tagName="td"
              class={{concat-classes "property-value creator" (if creatorIcon "has-icon") (if isSpecialCreator "special")}}
            >
              {{#if creatorIcon}}
                <OneIcon @icon={{creatorIcon}} />
              {{/if}}
              {{creatorName}}
            </TruncatedString>
          {{/if}}
        </tr>
        <tr>
          <td class="property-name">{{tt this "creationTime"}}</td>
          <td class="property-value creation-time">{{creationTime}}</td>
        </tr>
        {{yield}}
        <tr>
          <td class="property-name">{{tt this "id"}}</td>
          <td class="property-value id">
            <OneClipboardLine
              @size="sm"
              @value={{record.entityId}}
              @showText={{false}}
              @btnType="success"
            />
          </td>
        </tr>
      </tbody>
    </table>
  </PromiseProxyContainer>
</OneTile>
