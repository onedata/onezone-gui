<ContentInfo
  class="scroll-breakpoint-500"
  @header={{tt this "title"}}
  @text={{tt this "text"}}
>
  <p class="lead">
    <ul class="info">
      <li>
        <LinkTo
          @route="onedata.sidebar.content"
          @models={{array "atm-inventories" "new"}}
        >
          {{tt this "aCreateAtmInventory"}}
        </LinkTo>
      </li>
      <li>
        {{tt this "pJoinAtmInventory"}}
        <LinkTo @route="onedata.sidebar.content" @models={{array "tokens" "join"}}>
          {{tt this "aJoinAtmInventory"}}
        </LinkTo>
      </li>
      <li>
        {{tt this "p1JoinGroup"}}
        <LinkTo @route="onedata.sidebar.content" @models={{array "tokens" "join"}}>
          {{tt this "aJoinGroup"}}
        </LinkTo>
        {{tt this "p2JoinGroup"}}
      </li>
    </ul>
  </p>
</ContentInfo>
