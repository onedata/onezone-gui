<OneproviderViewContainer @contentContainerClass="content-spaces-shares-content" @space={{space}} @oneproviderId={{oneproviderId}} @mapSelectorEnabled={{false}} @resourceType="shares" @oneproviderIdChanged={{action "oneproviderIdChanged"}} @hasEmbeddedIframesChanged={{action "hasEmbeddedIframesChanged"}} as |container|>
  <container.header class="content-spaces-shares-header">
    {{#if shareId}}
      <h1 class="normal-case with-back with-menu">
        <span class="one-label">
          <TruncatedString>
            <LinkTo @query={{hash options=blankShareIdOptions}} class="content-back-link">
              <OneIcon
                @icon="browser-share"
                class="content-back-resource-icon"
              /><OneIcon
                @icon="arrow-left"
                class="content-back-arrow-icon"
              />
            </LinkTo>
            <span class="share-name resource-name">
              <NameConflict
                @item={{shareProxy.content}}
                @tagName="span"
                class="one-label"
              />
            </span>
          </TruncatedString>
        </span>
      </h1>
    {{else}}
      <h1>{{tt this "listHeader"}}</h1>
    {{/if}}
  </container.header>
  <container.body>
    <EmbeddedContentSpaceShares
      @oneprovider={{container.selectedProvider}}
      @baseUrl={{container.contentIframeBaseUrl}}
      @spaceId={{space.entityId}}
      @onShowShareList={{action "onShowShareList"}}
    />
  </container.body>
</OneproviderViewContainer>
