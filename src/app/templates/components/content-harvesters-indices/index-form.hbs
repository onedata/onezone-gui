<form onsubmit={{prevent-default}} class="form form-horizontal form-component clearfix">
  <FormComponent::FieldRenderer @field={{fields}} />
  {{#if (eq mode "create")}}
    <div class="btn-toolbar">
      <OneButton class="cancel-btn" @disabled={{isCreating}} @onClick={{onCancel}}>
        {{tt this "cancelBtnText"}}
      </OneButton>
      <OneButton
        @type="primary"
        class="create-btn"
        @disabled={{not fields.isValid}}
        @onClick={{action "create"}}
      >
        {{tt this "createBtnText"}}
      </OneButton>
    </div>
  {{/if}}
</form>
{{yield}}
