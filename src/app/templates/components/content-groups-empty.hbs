<ContentInfo
  class="scroll-breakpoint-400"
  @header={{tt this "title"}}
  @text={{tt this "text"}}
>
  <p class="lead">
    {{tt this "textStart"}}
    <LinkTo
      @route="onedata.sidebar.content"
      @models={{array "groups" "new"}}
    >{{tt this "textCreate"}}</LinkTo>
    {{tt this "textOr"}}
    <LinkTo
      @route="onedata.sidebar.content"
      @models={{array "tokens" "join"}}
    >{{tt this "textJoin"}}</LinkTo>
    {{tt this "textEnd"}}
  </p>
</ContentInfo>
