<form class="form form-horizontal form-component">
  <FormComponent::FieldRenderer @field={{fields}} />
  {{#if (or (eq mode "create") (eq mode "edit"))}}
    <div class="btn-toolbar footer-buttons">
      <OneButton
        @type="primary"
        @buttonType="submit"
        class="btn-submit"
        @onClick={{action "submit"}}
        @disabled={{not fields.isValid}}
      >
        {{tt this (concat "submit." mode)}}
      </OneButton>
      <OneButton
        class="btn-cancel"
        @disabled={{isSubmitting}}
        @onClick={{action "cancel"}}
      >
        {{tt this "cancel"}}
      </OneButton>
    </div>
  {{/if}}
</form>
{{yield}}
