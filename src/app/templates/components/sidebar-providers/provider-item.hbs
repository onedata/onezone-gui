<OneIconTagged
  class={{concat "sidebar-item-icon" (if offline " item-error")}}
  @icon="provider"
  @tagIcon={{if offline "x"}}
  @shadowType="none"
/>
<TruncatedString class="sidebar-item-title">
  <NameConflict @item={{item}} @tagName="span" class="one-label" />
</TruncatedString>
{{#if (or _spaceIdsLoaded _spacesLoaded)}}
  <StatusToolbar as |toolbar|>
    {{#if _spaceIdsLoaded}}
      <toolbar.icon
        @icon="space"
        @innerText={{_spaces.length}}
        @hint={{tt this "spaceCountHint" count=_spaces.length}}
      />
    {{/if}}
    {{#if _spacesLoaded}}
      <toolbar.icon
        @icon="provider"
        @outerText={{_totalSupportSizeHumanReadable}}
        @hint={{tt this "totalSupportHint" size=_totalSupportSizeHumanReadable}}
      />
    {{/if}}
  </StatusToolbar>
{{/if}}

{{#unless inSidenav}}
  <ActionsToolbar
    @isMinimized={{true}}
    @dropdownPlacement="auto"
    @actionsArray={{itemActions}}
  />
{{/unless}}
