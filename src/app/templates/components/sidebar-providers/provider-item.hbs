<OneIconTagged
  class={{concat "sidebar-item-icon" (if this.offline " item-error")}}
  @icon="provider"
  @tagIcon={{if this.offline "x"}}
  @shadowType="none"
/>
<TruncatedString class="sidebar-item-title">
  <NameConflict @item={{this.item}} @tagName="span" class="one-label" />
</TruncatedString>
{{#if (or this.isSpacesCountAvailable this.areSpacesLoaded)}}
  <StatusToolbar as |toolbar|>
    {{#if this.isSpacesCountAvailable}}
      <toolbar.icon
        @icon="space"
        @innerText={{this.spacesCount}}
        @hint={{tt this "spaceCountHint" count=this.spacesCount}}
      />
    {{/if}}
    {{#if this.areSpacesLoaded}}
      <toolbar.icon
        @icon="provider"
        @outerText={{this.totalSupportSizeHumanReadable}}
        @hint={{tt this "totalSupportHint" size=this.totalSupportSizeHumanReadable}}
      />
    {{/if}}
  </StatusToolbar>
{{/if}}

{{#unless this.inSidenav}}
  <ActionsToolbar
    @isMinimized={{true}}
    @dropdownPlacement="auto"
    @actionsArray={{this.itemActions}}
  />
{{/unless}}
