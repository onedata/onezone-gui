<p>{{tt this "intro.tokenDefinition"}} <OneDocSeeMore @topic="tokens" /></p>
<p>{{tt this "intro.templatesDescription"}}</p>
<p>{{tt this "intro.inviteTokensNote"}}</p>
<OneCollapsibleList as |list|>
  <list.item as |listItem|>
    <listItem.header><h1>{{tt this "templateCategories.basic"}}</h1></listItem.header>
    <listItem.content>
      <div class="one-tile-container">
        <TokenTemplateSelector::OneclientTemplate @onSelected={{onTemplateSelected}} />
        <TokenTemplateSelector::S3Template @onSelected={{onTemplateSelected}} />
        <TokenTemplateSelector::OneproviderRestTemplate
          @onSelected={{onTemplateSelected}}
        />
        <TokenTemplateSelector::OnezoneRestTemplate @onSelected={{onTemplateSelected}} />
      </div>
    </listItem.content>
  </list.item>
  <list.item as |listItem|>
    <listItem.header><h1>{{tt this "templateCategories.advanced"}}</h1></listItem.header>
    <listItem.content>
      <div class="one-tile-container">
        <TokenTemplateSelector::OneclientInOneproviderTemplate
          @onSelected={{onTemplateSelected}}
        />
        <TokenTemplateSelector::ReadonlyDataTemplate @onSelected={{onTemplateSelected}} />
        <TokenTemplateSelector::ReadonlyDataForUserTemplate
          @onSelected={{onTemplateSelected}}
        />
        <TokenTemplateSelector::RestrictedDataTemplate
          @onSelected={{onTemplateSelected}}
        />
        <TokenTemplateSelector::OnepanelRestTemplate @onSelected={{onTemplateSelected}} />
        <TokenTemplateSelector::IdentityTemplate @onSelected={{onTemplateSelected}} />
      </div>
    </listItem.content>
  </list.item>
  <list.item as |listItem|>
    <listItem.header
      @click={{action "onCustomTemplateSelected"}}
      @disableToggleIcon={{true}}
      class="template-custom"
    >
      <h1>
        {{tt this "templateCategories.custom"}}
        <OneIcon @icon="arrow-right" class="category-link-arrow" />
      </h1>
    </listItem.header>
  </list.item>
</OneCollapsibleList>

{{yield}}
