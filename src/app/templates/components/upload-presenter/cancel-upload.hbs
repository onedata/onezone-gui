<OneIcon @class={{concat-classes "cancel-action" iconClass (concat "cancel-ack-" parentView.elementId) (if canCancel "clickable" "disabled")}} @icon="ban-left" @click={{action "toggleAckPopover" (not ackPopoverOpened)}}>
  <OneTooltip @title={{tt this (if isCancelled "cancelled" "cancel")}} />
</OneIcon>
{{#if canCancel}}
  <RenderLater @triggerRender={{ackPopoverOpened}}>
    <OneWebuiPopover
      class="cancel-ack"
      @triggerSelector={{concat ".cancel-ack-" parentView.elementId}}
      @open={{ackPopoverOpened}}
    >
      <ClickOutside
        @onClickOutside={{action "toggleAckPopover" false}}
        @exceptSelector={{concat ".cancel-ack-" parentView.elementId}}
      >
        <h1>{{tt this "ackHeader"}}</h1>
        <p>{{tt this "ackMessage"}}</p>
        <div class="text-right">
          <OneButton
            @type="default"
            @size="sm"
            @onClick={{action "toggleAckPopover" false}}
          >
            {{tt this "ackNo"}}
          </OneButton>
          <OneButton @type="danger" @size="sm" @onClick={{action "cancel"}}>
            <OneIcon @icon="ban-left" />
            <span class="text">{{tt this "ackYes"}}</span>
          </OneButton>
        </div>
      </ClickOutside>
    </OneWebuiPopover>
  </RenderLater>
{{/if}}
