<PerfectScrollbarElement>
  {{#each uploadObjects as |uploadObject|}}
    <UploadPresenter::UploadObject
      @nestingStyle={{nestingStyle}}
      @uploadObject={{uploadObject}}
      @onCancel={{action onCancel}}
      @onExpand={{action "childrenExpanded" uploadObject}}
    />
  {{/each}}
</PerfectScrollbarElement>
